# Copy to .env and fill in what you need. Every variable is optional:
# with nothing set, the app runs on sample data with the built-in question parser.
#   Local:  set -a && source .env && set +a && streamlit run app.py
#   Docker: docker run --env-file .env -p 8501:8501 ai-analytics-dashboard

# Ask Data: let GLM-4.5-Flash (Z.ai) interpret free-form questions
ZAI_API_KEY=
# ZAI_MODEL=glm-4.5-flash
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# Maximum rows read from an uploaded file (larger files are truncated with a warning)
MAX_UPLOAD_ROWS=200000

# Optional sign-in allow-lists (only used when [auth] is configured in .streamlit/secrets.toml)
# ALLOWED_EMAIL_DOMAINS=example.com
# ALLOWED_EMAILS=someone@example.com
